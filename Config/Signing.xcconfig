// Default: ad-hoc signing so the project builds on any machine and in CI
// without provisioning setup.
//
// Ad-hoc signatures change on every rebuild, which makes macOS reset TCC
// grants (Accessibility, Full Disk Access, ...). For day-to-day development
// copy Signing.local.xcconfig.example to Signing.local.xcconfig and sign with
// a stable identity instead — the include below picks it up automatically.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =

#include? "Signing.local.xcconfig"
