// Signing defaults: ad-hoc, so the project builds on any machine and in CI
// without provisioning setup.
//
// Ad-hoc signatures change on every rebuild, which makes macOS reset TCC grants
// (Accessibility, Full Disk Access, ...). For day-to-day development run
// `make setup` or copy Signing.local.xcconfig.example to Signing.local.xcconfig
// to sign with a stable identity instead — the include below picks it up.
//
// The values are read by the app target through SIDEKICK_* variables. Setting
// CODE_SIGN_IDENTITY here directly would not work: Tuist writes its own value at
// target level, and target settings win over a project-level xcconfig.
SIDEKICK_CODE_SIGN_STYLE = Manual
SIDEKICK_CODE_SIGN_IDENTITY = -
SIDEKICK_DEVELOPMENT_TEAM =

#include? "Version.xcconfig"
#include? "Signing.local.xcconfig"
