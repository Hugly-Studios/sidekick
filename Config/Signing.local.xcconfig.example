// Copy to Signing.local.xcconfig (gitignored) to sign with your own identity,
// or just run `make setup`, which generates it from your keychain.
//
// A stable signature keeps macOS permission grants across rebuilds and
// reinstalls, because TCC keys them to the signing team.
//
// Find your team id with:
//   security find-identity -v -p codesigning
SIDEKICK_CODE_SIGN_STYLE = Manual
SIDEKICK_CODE_SIGN_IDENTITY = Apple Development
SIDEKICK_DEVELOPMENT_TEAM = YOUR_TEAM_ID
